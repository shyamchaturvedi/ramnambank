rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // केवल एडमिन ही संवेदनशील सेटिंग्स या रोल्स बदल सके
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'iammshyam@gmail.com' ||
        (exists(/databases/$(database)/documents/members/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role == 'ADMIN')
      );
    }

    // Members collection
    match /members/{memberId} {
      allow read: if true;
      allow create: if true;
      // सामान्य यूजर अपना डेटा अपडेट कर सकता है, लेकिन role सिर्फ ADMIN बदल सकता है
      allow update: if isAuthenticated() && (
        isAdmin() || 
        (isOwner(memberId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])))
      );
      allow delete: if isAdmin();
    }

    // Membership Requests / Orders collection
    match /membership_requests/{requestId} {
      allow read: if true;
      allow create: if true;
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // Booklet Submissions collection
    match /booklet_submissions/{submissionId} {
      allow read: if true;
      allow create: if true;
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // Donations collection
    match /donations/{donationId} {
      allow read: if true;
      allow create: if true;
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // System Settings & Branches (केवल एडमिन एडिट कर सके)
    match /system_settings/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /branches/{branchId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
